import("stdfaust.lib");
freq = hslider("freq", 55, 20, 8000, 0.01);
gain = hslider("gain", 0.5, 0, 1, 0.01);
gate = button("gate");
freq_s = freq : si.smoo;
gain_s = gain : si.smoo;
cutoff = hslider("Cutoff[unit:Hz]", 1200, 50, 8000, 1) : si.smoo;
res = hslider("Resonance", 0.7, 0, 5, 0.01) : si.smoo;
attack = hslider("Attack[unit:s]", 0.01, 0.001, 2, 0.001);
decay = hslider("Decay[unit:s]", 0.2, 0.001, 5, 0.001);
sustain = hslider("Sustain", 0.6, 0, 1, 0.01);
release = hslider("Release[unit:s]", 0.3, 0.001, 5, 0.001);
env = en.adsr(attack, decay, sustain, release, gate);
subMix = hslider("Sub Mix", 0.5, 0, 1, 0.01) : si.smoo;
subDetune = hslider("Sub Detune[unit:Hz]", 2, 0, 20, 0.01) : si.smoo;
mainOsc = os.sawtooth(freq_s);
subOsc = os.square((freq_s * 0.5) + subDetune);
voice = mainOsc + (subOsc * subMix);
filtered = voice : fi.resonlp(cutoff, res, 1);
process = filtered * (gain_s * env);