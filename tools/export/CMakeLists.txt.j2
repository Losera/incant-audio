# {{ plugin_name }} — exported from PluginForge
# Generated by tools/export_repo.py
#
# Build:
#   cmake -B build -DCMAKE_BUILD_TYPE=Release
#   cmake --build build
#
# The plugin will appear in build/ as a VST3 or Standalone.

cmake_minimum_required(VERSION 3.22)
project({{ plugin_name }} VERSION 1.0.0)

set(JUCE_PATH "$ENV{HOME}/JUCE" CACHE PATH "Path to JUCE root")
if(NOT EXISTS "${JUCE_PATH}/CMakeLists.txt")
    message(FATAL_ERROR "JUCE not found at ${JUCE_PATH}. Set -DJUCE_PATH=...")
endif()
add_subdirectory(${JUCE_PATH} JUCE)

juce_add_plugin({{ plugin_name }}
    PLUGIN_MANUFACTURER_CODE Pfge
    PLUGIN_CODE Pfh1
    FORMATS VST3 Standalone
    PRODUCT_NAME "{{ plugin_name }}"
    IS_SYNTH {{ is_synth }}
    NEEDS_MIDI_INPUT {{ needs_midi }}
    NEEDS_MIDI_OUTPUT FALSE
    IS_MIDI_EFFECT FALSE
    EDITOR_WANTS_KEYBOARD_FOCUS TRUE
    VST3_CATEGORIES {{ vst3_category }}
    COPY_PLUGIN_AFTER_BUILD TRUE
    NEEDS_WEB_BROWSER FALSE
    NEEDS_CURL FALSE
)

target_sources({{ plugin_name }} PRIVATE Source/Plugin.cpp Source/PluginEditor.cpp)

target_compile_features({{ plugin_name }} PRIVATE cxx_std_17)

target_compile_definitions({{ plugin_name }} PRIVATE
    JUCE_WEB_BROWSER=0
    JUCE_USE_CURL=0
    JUCE_VST3_CAN_REPLACE_VST2=0
)

find_library(LIBFAUST_LIB faust REQUIRED
    HINTS /usr/lib /usr/local/lib)

target_link_libraries({{ plugin_name }} PRIVATE
    juce::juce_audio_utils
    juce::juce_dsp
    juce::juce_gui_extra
    juce::juce_recommended_config_flags
    juce::juce_recommended_warning_flags
    ${LIBFAUST_LIB}
)
