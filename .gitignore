# --- Secrets ---
.env

# --- Python ---
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
dist/

# --- Build output ---
build/
build-release/
*.o
*.a
*.so
*.vst3
*.component

# --- Generated artifacts ---
artifacts/

# --- Melchior (private instrumentation, currently inert) ---
.melchior/

# --- In-source CMake residue -------------------------------------------------
# cmake was run directly in host/ as well as in host/build/, leaving ~400M of
# build tree beside the sources. These are anchored to /host/ so an equivalent
# name elsewhere in the repo is still tracked.
/host/CMakeCache.txt
/host/CMakeFiles/
/host/cmake_install.cmake
/host/Makefile
/host/juce_vst3_helper

# JUCE build tree emitted by the host configure step (CMakeFiles/, Makefile,
# modules/ ...) — not a source clone. Real JUCE lives at $HOME/JUCE via
# -DJUCE_PATH, see host/README.md.
/host/JUCE/

# JUCE per-target output dirs (PluginForgeHost_artefacts, ParamPoolTsanTest_artefacts)
*_artefacts/

# --- Local-only tool config --------------------------------------------------
# .claude/{hooks,agents,skills}/ and settings.json ARE project architecture and
# stay tracked (see README "Agentic architecture"); only per-machine overrides
# are ignored.
settings.local.json
scheduled_tasks.lock

# Throwaway --dry-run output. Real runs write results.json, which is tracked
# evidence; a 1-record smoke test must never stand in for it.
bench/results/results_dryrun.json

# PF-025 concurrency lock — process-local state, never committed. A checked-in lock
# would refuse every run on a fresh clone until someone deleted it by hand.
bench/results/.run.lock
.env.*
!.env.example

# agent-session git worktrees (separate checkouts, not repo content). Found two more
# instances of this same pattern outside .claude/ during the 2026-08-19 doc audit --
# a full second PluginForge checkout and an unrelated repo (soundfetch), both silently
# polluting `git status` and recursive greps because only the .claude/ path was ignored.
.claude/worktrees/
.worktrees/
bench/.worktrees/

# Claude Code plan-mode working files (transient planning scratch, not content)
.claude/plans/

# ADR-028 handoff protocol. Session-to-session working state, not repo content --
# same reasoning as .claude/plans/ above. HANDOFF.md and handoff-state.json are each
# overwritten in place, never appended, so those two are always 0-2 files, never an
# accumulating log. HANDOFF.md is agent-authored prose; handoff-state.json is
# machine-captured by handoff_precompact.py and MUST stay untracked too, or a stale
# compaction snapshot could get committed and read as current.
.claude/HANDOFF.md
.claude/handoff-state.json

# Claude Code's own near-limit resume file (CLAUDE.md, .claude/skills/handoff/SKILL.md
# both reference it as a /handoff trigger). Written by the harness itself, not this
# repo's tooling; only ever ignored locally via .git/info/exclude before 2026-08-25,
# which doesn't travel to a fresh checkout -- CI's dead-link checks
# (tests/test_control_wiring.py's TestExtensionsDoNotReferenceDeletedFiles /
# TestLiveDocsDoNotReferenceDeletedFiles) flagged both references as broken the first
# time a `design/ember-console` CI run actually reached them, previously masked by the
# unrelated PF-067 collection failure aborting the suite before these tests ran. Same
# "session-to-session working state, not repo content" reasoning as
# HANDOFF.md/handoff-state.json above.
/.claude/RESUME.md

# The one deliberate exception: handoff-log.jsonl IS append-only, by design -- added
# 2026-08-21 so "is /handoff actually getting used" is a count, not a memory, for the
# real-usage evaluation window before ADR-028 gets pushed. Pure observation, never
# read by either hook; local per-machine telemetry, never repo content.
.claude/handoff-log.jsonl

# PF-014 real-user prompt log. Local observation data, not repo content: it records
# what a person actually typed at this machine. Never committed — the benchmark
# corpus is derived from it by hand, deliberately.
/logs/

# ADR-031 (Proposed): Obsidian is permitted only as a personal, non-authoritative
# lens over the existing markdown corpus. Nothing authoritative lives only in the
# vault; no tool/hook/test/skill may depend on it. .obsidian/ is per-machine editor
# config; docs/_graph.md is generated by tools/kg.py (WP3b) — both are working
# state, not repo content, same reasoning as .claude/plans/ above.
/.obsidian/
/docs/_graph.md
