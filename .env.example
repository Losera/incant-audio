# ── Provider selection ────────────────────────────────────────────────────────
# Which LLM generates the Faust DSL. PluginForge is free-only by default: the
# paid provider (anthropic) is refused unless PLUGINFORGE_ALLOW_PAID=1.
#
# Verify any choice with:  python llm/providers.py --check all
#
#   gemini      free tier, no card. Measured 2026-07-21: the binding limit is
#               requests-per-DAY-per-model, and it is small — gemini-3.6-flash
#               returned quotaValue 20. Waiting does not help; switch model
#               (the quota is PerProjectPerModel) or switch provider.
#   groq        free tier, no card. NOT the volume option -- corrected 2026-08-13,
#               matching llm/providers.py's own 2026-07-28 correction: the old
#               "~14,400 requests/day" figure was unverified, and requests were
#               never the binding limit anyway. What actually binds is
#               200,000 tokens/DAY and 8,000 tokens/MINUTE -- at ~3,500 tokens
#               per generation that's ~57 generations/day, comparable to the
#               other free providers, not a volume tier.
#   openrouter  free ':free' models, ~50 requests/day until $10 spent
#   ollama      fully local, no key, no quota, works offline
#
# Default is `ollama` so a fresh install generates with NO credential step at all
# (it needs a local ollama with a code model pulled — `ollama pull qwen2.5-coder:7b`).
# For a hosted free tier instead, set `groq` (or `gemini` / `openrouter`) here and
# add its key below. If this line is removed entirely, llm/providers.py falls back
# to `groq` (`DEFAULT_PROVIDER`).
PLUGINFORGE_PROVIDER=ollama

# Optional: override the provider's default model id. Model ids churn — list the
# live ones with:  python llm/providers.py --list-models <provider>
# PLUGINFORGE_MODEL=

# Optional: seconds to space API calls apart, to stay under a free tier's
# per-minute cap during a long benchmark run. 0/unset disables pacing.
# PLUGINFORGE_MIN_INTERVAL=13

# Optional: set to 1 to permit the PAID anthropic provider. Off by default.
# PLUGINFORGE_ALLOW_PAID=1

# ── Credentials (only the selected provider's key is needed) ──────────────────
# ollama needs none.
GOOGLE_API_KEY=your_key_here          # https://aistudio.google.com/apikey
# GROQ_API_KEY=your_key_here          # https://console.groq.com
# OPENROUTER_API_KEY=your_key_here    # https://openrouter.ai/keys
# ANTHROPIC_API_KEY=your_key_here     # https://console.anthropic.com  (PAID)

JUCE_PATH=/home/youruser/JUCE

# ── Sample search (host/Source/SoundfetchClient.cpp) ───────────────────────────
# The sample browser shells out to the separate `soundfetch` project
# (github.com/Losera/soundfetch) via `<python> -m soundfetch`, the same
# interpreter-resolution shape as the generator subprocess above.
#
#   PLUGINFORGE_SOUNDFETCH_PYTHON   interpreter that can `import soundfetch`
#                                   (e.g. a venv's bin/python). Falls back to
#                                   PLUGINFORGE_PYTHON, then bare "python3" on
#                                   PATH -- which will fail unless soundfetch
#                                   is installed into that interpreter.
#   SOUNDFETCH_BIN                  escape hatch: bypasses Python resolution
#                                   entirely and runs this executable directly
#                                   (e.g. a venv's bin/soundfetch on PATH).
# PLUGINFORGE_SOUNDFETCH_PYTHON=/home/youruser/soundfetch/.venv/bin/python

# Optional: override the interpreter llm/generate.py runs under (PromptPanel.cpp).
# Same fallback role as PLUGINFORGE_SOUNDFETCH_PYTHON above, for the generator
# instead of the sample browser. Defaults to bare "python3" on PATH.
# PLUGINFORGE_PYTHON=/usr/bin/python3
