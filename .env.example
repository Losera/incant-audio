# ── Provider selection ────────────────────────────────────────────────────────
# Which LLM generates the Faust DSL. PluginForge is free-only by default: the
# paid provider (anthropic) is refused unless PLUGINFORGE_ALLOW_PAID=1.
#
# Verify any choice with:  python llm/providers.py --check all
#
#   gemini      free tier, no card, ~5 requests/minute PER MODEL
#   groq        free tier, no card, up to ~14,400 requests/day (volume runs)
#   openrouter  free ':free' models, ~50 requests/day until $10 spent
#   ollama      fully local, no key, no quota, works offline
PLUGINFORGE_PROVIDER=gemini

# Optional: override the provider's default model id. Model ids churn — list the
# live ones with:  python llm/providers.py --list-models <provider>
# PLUGINFORGE_MODEL=

# Optional: seconds to space API calls apart, to stay under a free tier's
# per-minute cap during a long benchmark run. 0/unset disables pacing.
# PLUGINFORGE_MIN_INTERVAL=13

# Optional: set to 1 to permit the PAID anthropic provider. Off by default.
# PLUGINFORGE_ALLOW_PAID=1

# ── Credentials (only the selected provider's key is needed) ──────────────────
# ollama needs none.
GOOGLE_API_KEY=your_key_here          # https://aistudio.google.com/apikey
# GROQ_API_KEY=your_key_here          # https://console.groq.com
# OPENROUTER_API_KEY=your_key_here    # https://openrouter.ai/keys
# ANTHROPIC_API_KEY=your_key_here     # https://console.anthropic.com  (PAID)

JUCE_PATH=/home/youruser/JUCE
